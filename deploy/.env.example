# This file configures Compose, not a shell script. Never commit a real .env.
DATABASE_PASSWORD=replace-with-a-random-local-password
OPENAI_API_KEY=
OPENAI_MODEL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
SEED_GLOBAL_MEMORY=true
WORKER_ENABLED=true
HOST_PORT=8080
HEALTHCHECK_PATH=/api/v1/global-memory
